# OPTIX Brokerage Integrations - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Application Settings
# ============================================================================
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/optix
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# Redis Configuration (for OAuth state management)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# Schwab/TD Ameritrade API Credentials
# ============================================================================
SCHWAB_CLIENT_ID=your_schwab_client_id_here
SCHWAB_CLIENT_SECRET=your_schwab_client_secret_here
SCHWAB_REDIRECT_URI=https://yourdomain.com/oauth/callback/schwab

# ============================================================================
# Fidelity API Credentials
# ============================================================================
FIDELITY_CLIENT_ID=your_fidelity_client_id_here
FIDELITY_CLIENT_SECRET=your_fidelity_client_secret_here
FIDELITY_REDIRECT_URI=https://yourdomain.com/oauth/callback/fidelity

# ============================================================================
# Plaid API Credentials (for Robinhood integration)
# ============================================================================
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox  # Options: sandbox, development, production

# ============================================================================
# Interactive Brokers API Credentials
# ============================================================================
IBKR_CLIENT_ID=your_ibkr_client_id_here
IBKR_CLIENT_SECRET=your_ibkr_client_secret_here
IBKR_REDIRECT_URI=https://yourdomain.com/oauth/callback/ibkr
IBKR_USE_GATEWAY=false  # Set to true to use local Client Portal Gateway

# ============================================================================
# Webull API Credentials
# ============================================================================
WEBULL_CLIENT_ID=your_webull_client_id_here
WEBULL_CLIENT_SECRET=your_webull_client_secret_here
WEBULL_REDIRECT_URI=https://yourdomain.com/oauth/callback/webull

# ============================================================================
# Security Configuration
# ============================================================================
# Generate using: python -c "from src.brokerage_service.encryption import TokenEncryption; print(TokenEncryption.generate_key())"
TOKEN_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# General API secret key
SECRET_KEY=your_secret_key_here

# ============================================================================
# OAuth Configuration
# ============================================================================
# How long OAuth state tokens are valid (in minutes)
OAUTH_STATE_TTL_MINUTES=10

# How many minutes before token expiry to trigger refresh
TOKEN_REFRESH_BUFFER_MINUTES=5

# ============================================================================
# Sync Configuration
# ============================================================================
# Automatic sync interval for all accounts (in minutes)
SYNC_INTERVAL_MINUTES=15

# Maximum time to wait for position sync (in seconds)
POSITION_SYNC_TIMEOUT_SECONDS=30

# Maximum number of worker threads
MAX_WORKERS=4

# ============================================================================
# API Server Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false  # Set to true for development

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Enable debug mode (NOT for production!)
DEBUG=false

# ============================================================================
# Notes
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Keep your API credentials secure
# 3. Rotate TOKEN_ENCRYPTION_KEY periodically
# 4. Use different credentials for development/staging/production
# 5. Set PLAID_ENV to 'production' only when ready for live data
# 6. Set DEBUG=false in production
